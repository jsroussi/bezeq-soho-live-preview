+import test from 'node:test';import assert from 'node:assert/strict';import {syntheticScenario} from '../scripts/build-airlines-preview.mjs';import {attachActivity,summarizeActivity,getEffectiveResults} from '../site/src/airlines/activity.js';import {applyPublishedSnapshots} from '../site/src/airlines/model.js';
+const first=d=>d.site.people.find(p=>p.key===d.roles.rep.personKey),group=(s,id)=>s.groups.find(g=>g.id===id),product=(s,id)=>s.products.find(p=>p.id===id),publication=(week='1')=>({week,synthetic:true,totals:Object.fromEntries([21,24,15,32,20,11].map((n,i)=>['נציג דמה '+String(i+1).padStart(2,'0'),n]))});
+test('raw137 units accompany378 canonical stamps and all fixture products are configured',()=>{const {data,config,results}=syntheticScenario(),p=first(data);assert.equal(p.stampCard.stamps,378);assert.equal(group(p.activity,'sales').quantity,137);assert.deepEqual(p.activity.products.map(p=>p.quantity),[63,41,33]);assert.ok(results.every(r=>config.products[r.product]));});
+test('missing quantity differs from an explicit zero',()=>{const {data}=syntheticScenario(),p=first(data);data.engineModel.results=data.engineModel.results.filter(r=>!(r.who===p.key&&['ipc','internet'].includes(r.product)));data.engineModel.results.push({who:p.key,product:'ipc',count:0,date:'2026-11-05'});attachActivity(data);assert.equal(product(p.activity,'ipc').quantity,0);assert.equal(product(p.activity,'internet').quantity,null);assert.equal(group(p.activity,'sales').partial,true);});
+test('empty roster members keep missing products and future weeks absent',()=>{const {data}=syntheticScenario(),p=data.site.people.find(p=>p.name==='נציג דמה 06');assert.ok(p.activity.products.every(p=>p.quantity===null));assert.equal(group(p.activity,'sales').quantity,null);assert.ok(p.activity.weeks.slice(1).every(w=>w===null));});
+test('repeated bonus and gate inputs do not inflate raw quantities',()=>{const {data}=syntheticScenario(),r=data.engineModel.config.stamps.sectors.soho.rules;r.push({type:'beyond',products:['biznet'],stamps:999},{type:'gate',all:[{products:['biznet'],min:5}],stamps:1000},{type:'ladder',numerator:'removals',denominator:'answered_calls'});attachActivity(data);assert.equal(group(first(data).activity,'sales').quantity,137);assert.equal(first(data).activity.products.length,3);});
+test('week and contest boundaries exclude future and undated rows',()=>{const {data}=syntheticScenario('2026-11-12'),p=first(data);data.engineModel.results=data.engineModel.results.filter(r=>r.who!==p.key);for(const[date,count]of [['2026-11-01',2],['2026-11-05',3],['2026-11-08',5],['2026-11-12',7],['2026-11-13',11],['2026-10-31',13],[undefined,19]])data.engineModel.results.push({who:p.key,product:'biznet',date,count});attachActivity(data);assert.equal(product(p.activity,'biznet').quantity,17);assert.equal(product(p.activity.weeks[0],'biznet').quantity,5);assert.equal(product(p.activity.weeks[1],'biznet').quantity,12);});
+test('aggregation preserves separate units and partial input flags',()=>{const {data}=syntheticScenario(),get=n=>data.site.people.find(p=>p.name==='נציג דמה '+String(n).padStart(2,'0')),s=summarizeActivity([first(data),get(6),get(13),get(31)]);assert.deepEqual(s.groups.map(g=>g.id),['sales','agreements','forwarded','realized']);assert.equal(group(s,'sales').quantity,137);assert.equal(group(s,'sales').partial,true);assert.deepEqual(summarizeActivity([]),{groups:[],products:[],weeks:[]});});
+test('publication updates95 raw units and252 stamps without mutating baseline',()=>{const {data}=syntheticScenario(),before=JSON.stringify(data.engineModel.results),snapshots={'1':publication()};assert.equal(applyPublishedSnapshots(data,snapshots),true);const p=first(data);assert.equal(group(p.activity,'sales').quantity,95);assert.equal(p.stampCard.stamps,252);assert.deepEqual(p.activity.products.map(p=>p.quantity),[21,41,33]);assert.equal(JSON.stringify(data.engineModel.results),before);});
+test('invalid and future publications do not replace activity',()=>{for(const s of [{'1':{...publication(),synthetic:false}},{'2':publication('2')},{'1':{...publication(),totals:{unknown:42}}}]){const{data}=syntheticScenario();attachActivity(data,s);assert.equal(group(first(data).activity,'sales').quantity,137);assert.equal(getEffectiveResults(data,s).applicable.length,0);}});
