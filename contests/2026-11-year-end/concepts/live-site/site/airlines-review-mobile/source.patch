+import test from 'node:test';import assert from 'node:assert/strict';import {syntheticScenario} from '../scripts/build-airlines-preview.mjs';import {applyPublishedSnapshots} from '../site/src/airlines/model.js';
+const publication=()=>({week:'1',synthetic:true,at:'2026-11-05T17:00:00Z',totals:Object.fromEntries([21,24,15,32,20,11].map((v,i)=>['נציג דמה '+String(i+1).padStart(2,'0'),v]))});
+test('local synthetic publication recomputes participant stamps and eligibility with the canonical engine',()=>{const {data}=syntheticScenario(),person=data.site.people.find(p=>p.key===data.roles.rep.personKey),other=data.site.people.find(p=>p.name==='נציג דמה 07'),untouched=other.stampCard.stamps;assert.equal(person.stampCard.stamps,378);assert.equal(applyPublishedSnapshots(data,{'1':publication()}),true);assert.equal(person.stampCard.stamps,252);assert.equal(person.stampCard.draw.met,false);assert.equal(person.stampCard.class,null);assert.equal(other.stampCard.stamps,untouched);assert.equal(data.site.race.find(r=>r.key===person.key).stamps,252);assert.equal(person.weeks[0],252);});
+test('non-synthetic or invalid snapshots cannot alter the preview',()=>{for(const bad of [{...publication(),synthetic:false},{...publication(),totals:{'unknown':42}},{...publication(),totals:{'נציג דמה 01':-2}},{...publication(),week:'99'}]){const {data}=syntheticScenario(),before=JSON.stringify(data.site);assert.equal(applyPublishedSnapshots(data,{'1':bad}),false);assert.equal(JSON.stringify(data.site),before);}});
+test('future-week publications stay separate from current results',()=>{const {data}=syntheticScenario(),before=JSON.stringify(data.site);assert.equal(applyPublishedSnapshots(data,{'2':{...publication(),week:'2'}}),false);assert.equal(JSON.stringify(data.site),before);});
